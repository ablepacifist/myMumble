# Copy to .env (never commit .env) and fill in. Real values are kept in the private computer-documentation repo.
WS_PORT=3080
MUMBLE_HOST=127.0.0.1
MUMBLE_PORT=64738

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mumble
MYSQL_PASSWORD=
MYSQL_DATABASE_MUMBLE=mumble_server
MYSQL_DATABASE_BRIDGE=mumble_bridge

LEXICON_API_URL=https://api.alex-dyakin.com
# The login the bridge uses for its own Lexicon calls
LEXICON_SERVICE_USER=
LEXICON_SERVICE_PASSWORD=

LOG_LEVEL=info
VOICE_DIAG_ENABLED=false
SUPERUSER_NAMES=
