# Copy to .env (never commit .env) and fill in. Real values are kept in the private computer-documentation repo.
#
# Inside full-back-end-server this file is optional: the bridge reads the root .env first (./restart-all exports
# MASTER_ENV_FILE) and only uses its own .env for keys the root file does not define. Put shared values
# (LEXICON_SERVICE_TOKEN, VAPID_*, ports) in the root .env.
#
# BRIDGE_PORT is the name used in the root .env; WS_PORT is the old name and still works.
BRIDGE_PORT=3080
# Listen address. The default 127.0.0.1 is right when cloudflared runs on the same machine; use 0.0.0.0 only if
# something on another machine must reach the bridge directly.
BRIDGE_HOST=127.0.0.1
MUMBLE_HOST=127.0.0.1
MUMBLE_PORT=64738

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mumble
MYSQL_PASSWORD=
MYSQL_DATABASE_MUMBLE=mumble_server
MYSQL_DATABASE_BRIDGE=mumble_bridge

# Leave unset when Lexicon runs on the same machine: the default is http://127.0.0.1:<LEXICON_PORT>.
# Set it (for example https://api.alex-dyakin.com) when the bridge runs somewhere else.
LEXICON_API_URL=
# The login the bridge uses for its own Lexicon calls
LEXICON_SERVICE_USER=
LEXICON_SERVICE_PASSWORD=
# Shared secret for Lexicon's X-Service-Token check; same value as LEXICON_SERVICE_TOKEN in aragorn's root .env
LEXICON_SERVICE_TOKEN=

# The music bot decodes audio with ffmpeg. Only needed when ffmpeg is not on the PATH of the process starting the bridge.
FFMPEG_PATH=

LOG_LEVEL=info
VOICE_DIAG_ENABLED=false
# Voice admin is decided by Lexicon: a verified login whose Lexicon permissions include VOICE_ADMIN (the ADMIN role).
# These Lexicon LOGIN names (comma separated) are only the fallback for when Lexicon gives no answer (older Lexicon
# or unreachable). Keep the real admin listed so a Lexicon outage cannot lock them out. Needs LEXICON_SERVICE_TOKEN
# for resumed sessions to ask Lexicon (GET /api/permissions/{id}).
SUPERUSER_NAMES=

# Login hardening. Transition switches, both false = the safe end state:
# ALLOW_NAME_ONLY_LOGIN=true keeps the old "type a name, no password" login working (anyone can claim any name).
# NAME_ONLY_ADMIN=true lets such name-only sessions be admin when their name is in SUPERUSER_NAMES. Avoid.
ALLOW_NAME_ONLY_LOGIN=false
NAME_ONLY_ADMIN=false
# ALLOW_LEGACY_APP_UPLOADS=true keeps avatar/image uploads from the installed Android app working (it sends no session
# token yet). Anyone could then upload as anyone. Turn off after the app is updated.
ALLOW_LEGACY_APP_UPLOADS=false
# Optional: lets command-line diagnostics tools read /api/diag/* (send "Authorization: Bearer <value>", 20+ chars).
DIAG_TOKEN=
SESSION_TTL_HOURS=24
# Content-Security-Policy for the web client: enforce | report-only (violations only logged in the browser console) | off
CSP_MODE=report-only
