# Copy to .env (never commit .env) and fill in. Real values are kept in the private computer-documentation repo.
WS_PORT=3080
MUMBLE_HOST=127.0.0.1
MUMBLE_PORT=64738

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mumble
MYSQL_PASSWORD=
MYSQL_DATABASE_MUMBLE=mumble_server
MYSQL_DATABASE_BRIDGE=mumble_bridge

LEXICON_API_URL=https://api.alex-dyakin.com
# The login the bridge uses for its own Lexicon calls
LEXICON_SERVICE_USER=
LEXICON_SERVICE_PASSWORD=
# Shared secret for Lexicon's X-Service-Token check; same value as LEXICON_SERVICE_TOKEN in aragorn's root .env
LEXICON_SERVICE_TOKEN=

LOG_LEVEL=info
VOICE_DIAG_ENABLED=false
# Lexicon LOGIN names (comma separated) that are admins. Only verified logins (Lexicon password or SSO) can be admin.
SUPERUSER_NAMES=

# Login hardening. Transition switches, both false = the safe end state:
# ALLOW_NAME_ONLY_LOGIN=true keeps the old "type a name, no password" login working (anyone can claim any name).
# NAME_ONLY_ADMIN=true lets such name-only sessions be admin when their name is in SUPERUSER_NAMES. Avoid.
ALLOW_NAME_ONLY_LOGIN=false
NAME_ONLY_ADMIN=false
# ALLOW_LEGACY_APP_UPLOADS=true keeps avatar/image uploads from the installed Android app working (it sends no session
# token yet). Anyone could then upload as anyone. Turn off after the app is updated.
ALLOW_LEGACY_APP_UPLOADS=false
# Optional: lets command-line diagnostics tools read /api/diag/* (send "Authorization: Bearer <value>", 20+ chars).
DIAG_TOKEN=
SESSION_TTL_HOURS=24
# Content-Security-Policy for the web client: enforce | report-only (violations only logged in the browser console) | off
CSP_MODE=report-only
